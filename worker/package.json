{
  "name": "picnic-subscriber-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute picnic-subscribers --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute picnic-subscribers --local --file=./schema.sql",
    "db:migrate": "wrangler d1 execute picnic-subscribers --remote --file=./schema-migration.sql",
    "db:migrate:local": "wrangler d1 execute picnic-subscribers --local --file=./schema-migration.sql"
  },
  "dependencies": {
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "wrangler": "^4.23.0"
  }
}
